# =============================================================================
# CEI ESTIMATION LLC - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# Next.js Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Company Brand Metadata
NEXT_PUBLIC_COMPANY_NAME="CEI Estimation LLC"
NEXT_PUBLIC_COMPANY_WEBSITE="https://www.ceiestimation.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@ceiestimation.com"

# Supabase PostgreSQL Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Private Object Storage (AWS S3 or Supabase Storage for Architectural Blueprints)
STORAGE_BUCKET_PLANS=cei-architectural-plans
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-west-2

# TraceScope / Scope Technologies Legacy Data Import Bridge (Optional)
LEGACY_TRACESCOPE_API_URL=https://tracescope.roofscope.com
LEGACY_API_ENABLED=false

